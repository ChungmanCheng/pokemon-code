{
  "name": "pokemon-code-2",
  "displayName": "pokemon-code-2",
  "description": "Catch, battle, and level up Pokemon while you or your coding agent edit code",
  "version": "2.0.2",
  "icon": "imgs/pokeball.png",
  "publisher": "chungmancheng",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension",
  "contributes": {
    "commands": [
      {
        "command": "extension.showPokemon",
        "title": "Pokemon Code - Pokedex"
      },
      {
        "command": "extension.showInventory",
        "title": "Pokemon Code - Inventory"
      },
      {
        "command": "pokemonCode.showBattle",
        "title": "Pokemon Code - Battle and Trainer"
      }
    ],
    "configuration": {
      "title": "Pokemon Code",
      "properties": {
        "pokemonCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable code rewards and automatic encounters."
        },
        "pokemonCode.trackExternalChanges": {
          "type": "boolean",
          "default": true,
          "description": "Count workspace files created, edited, or deleted on disk by coding agents and other tools."
        },
        "pokemonCode.encounterMode": {
          "type": "string",
          "enum": [
            "auto",
            "battle",
            "catch"
          ],
          "enumDescriptions": [
            "Pokemon battle automatically and collect new species when weakened.",
            "Automatically battle every encounter.",
            "Automatically collect every encounter; battle when supplies run out."
          ],
          "default": "auto",
          "description": "Automatic behavior for new encounters. No gameplay input is required."
        },
        "pokemonCode.editsPerEncounter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 8,
          "description": "Number of edit batches while exploring before a wild Pokemon appears."
        },
        "pokemonCode.activityCooldownMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000,
          "default": 3000,
          "description": "Combine code changes in this time window into one XP reward."
        },
        "pokemonCode.excludedDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional directory names to ignore for code rewards. Dependencies, build output, caches, and Git metadata are already ignored."
        },
        "pokemonCode.notifications": {
          "type": "boolean",
          "default": false,
          "description": "Show informational encounter and level-up notifications. No decisions are requested."
        },
        "pokemonCode.starter": {
          "type": "string",
          "enum": [
            "Bulbasaur",
            "Charmander",
            "Squirtle"
          ],
          "default": "Bulbasaur",
          "description": "Starter Pokemon for a new journey; existing collections are preserved."
        },
        "pokemonCode.turnIntervalMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000,
          "default": 2000,
          "description": "Time between automatic encounter turns. Battles continue when typing pauses."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "package-explorer",
          "title": "Pocket",
          "icon": "imgs/pokeball.svg"
        }
      ]
    },
    "views": {
      "package-explorer": [
        {
          "id": "package-battle",
          "name": "Battle and Trainer"
        },
        {
          "id": "package-pokedex",
          "name": "Pokedex"
        },
        {
          "id": "package-inventory",
          "name": "Inventory"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "npm run compile && node --test test/*.test.js",
    "test:integration": "npm run compile && node test/runIntegration.js"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "1.73.0",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "eslint": "^8.26.0",
    "typescript": "^4.8.4"
  }
}
